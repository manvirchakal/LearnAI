# Non-secret server settings (see server/.env.example for every option).
# vLLM serves one model per process: chat, embeddings and Whisper are
# usually three ports on the GPU host.
LLM_PROVIDER=openai
OPENAI_BASE_URL=http://192.168.1.50:8001/v1
LLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
LLM_VISION_ENABLED=true
# Must equal the chat model's --max-model-len; output and source budgets derive from it
LLM_CONTEXT_TOKENS=32768

EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=http://192.168.1.50:8002/v1
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

STT_PROVIDER=openai
STT_BASE_URL=http://192.168.1.50:8003/v1
STT_MODEL=openai/whisper-large-v3-turbo

TRANSLATION_PROVIDER=llm
MAX_UPLOAD_MB=200
LOG_LEVEL=INFO
