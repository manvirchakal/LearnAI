# ── LLM ──────────────────────────────────────────────────────────────────────
# openai = any OpenAI-compatible server (vLLM, llama.cpp, Ollama) · bedrock = Claude on AWS
LLM_PROVIDER=openai
# vLLM: http://<gpu-host>:<port>/v1. vLLM serves one model per process, so
# chat, embeddings and Whisper are usually three ports on the same host.
OPENAI_BASE_URL=http://localhost:8001/v1
OPENAI_API_KEY=EMPTY
# Empty = the first model the server lists (openai) / Claude defaults (bedrock)
LLM_MODEL=
# Model that reads scanned tables of contents; empty = LLM_MODEL
LLM_VISION_MODEL=
# Set false if the served model can't take images
LLM_VISION_ENABLED=true
# The served model's context length: must equal vLLM's --max-model-len.
# The output cap (a quarter of it) and the source-material limit (40% of it)
# are derived from this; uncomment the overrides only to tune them.
LLM_CONTEXT_TOKENS=131072
# LLM_MAX_OUTPUT_TOKENS=32768
# LLM_MAX_SOURCE_CHARS=210000
LLM_TIMEOUT_SECONDS=600

# Bedrock only. Empty keys = boto3's default chain (AWS_PROFILE, SSO, role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ── Embeddings (RAG) ─────────────────────────────────────────────────────────
# openai = /v1/embeddings on a model server · local = sentence-transformers ([local-ml])
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Empty = OPENAI_BASE_URL
EMBEDDING_BASE_URL=http://localhost:8002/v1

# ── Speech-to-text ───────────────────────────────────────────────────────────
# openai = /v1/audio/transcriptions (vLLM serving Whisper) · local = faster-whisper ([local-ml])
STT_PROVIDER=openai
# local: tiny | base | small | medium | large-v3
STT_MODEL=openai/whisper-large-v3-turbo
STT_BASE_URL=http://localhost:8003/v1
STT_CHUNK_SECONDS=600

# ── Translation ──────────────────────────────────────────────────────────────
# llm = the chat model translates · argos = argostranslate ([local-ml])
TRANSLATION_PROVIDER=llm

# ── Storage ──────────────────────────────────────────────────────────────────
# Uploads, metadata, generated materials, chat history and the vector store
# DATA_DIR=./data
# CHROMA_DIR=./data/vectorstore
MAX_UPLOAD_MB=200

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# JSON list; only needed if browsers call the API directly instead of via Next.js
CORS_ORIGINS=["http://localhost:3000"]
