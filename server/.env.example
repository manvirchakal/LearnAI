# ── Claude via AWS Bedrock (the only cloud dependency) ───────────────────────
# Leave the keys empty to use boto3's default chain (AWS_PROFILE, SSO, instance role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Any Bedrock model or inference-profile id your account can invoke
BEDROCK_MODEL_HAIKU=us.anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_MODEL_SONNET=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# ── Local services ───────────────────────────────────────────────────────────
# All uploads, metadata, generated materials and chat history live here
# DATA_DIR=./data
# CHROMA_DIR=./data/vectorstore
EMBEDDING_MODEL=all-MiniLM-L6-v2
# tiny | base | small | medium | large-v3
WHISPER_MODEL=base

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# JSON list of allowed browser origins (only needed if you bypass the Next.js proxy)
CORS_ORIGINS=["http://localhost:3000"]
