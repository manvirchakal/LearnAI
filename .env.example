# Copy to .env and fill in. Every value has a working default for local dev
# EXCEPT anthropic_api_key, which is required even in development because
# ingestion (native PDF reading) always uses Anthropic regardless of the
# generation backend below.

ENVIRONMENT=development

# --- datastores (defaults match docker-compose.yml service names) ----------
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=learnai
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379

# --- blob storage ------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_ROOT=/data/media
# Only needed if STORAGE_BACKEND=minio (required when the deployment target
# has no ReadWriteMany PVC for the api/worker to share):
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=

# --- llm: ingestion (always Anthropic) ---------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- llm: generation (narrative, game idea/code, diagrams, chat, translation)
# Defaults to Anthropic, reusing ANTHROPIC_API_KEY above. To point generation
# at OpenRouter, LM Studio, vLLM, Ollama, or any other OpenAI-compatible
# endpoint instead, set:
#   LLM_BACKEND=openai_compatible
#   LLM_BASE_URL=https://openrouter.ai/api/v1        # or http://localhost:1234/v1 for LM Studio
#   LLM_API_KEY=...                                   # omit for a keyless local server
#   LLM_MODEL_DEFAULT=anthropic/claude-opus-5          # a model id the endpoint recognizes
#   LLM_SUPPORTS_JSON_SCHEMA=false                     # if the endpoint can't guarantee schema output
LLM_BACKEND=anthropic
LLM_MODEL_DEFAULT=claude-opus-5

# --- auth ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=
SESSION_SECRET=change-me-to-a-random-32-plus-character-string
# Mounts POST /api/v1/auth/dev-login {email} so the whole stack runs with zero
# cloud accounts. The app refuses to start with this on in production.
DEV_AUTH_BYPASS=true

# --- http -----------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173"]

# --- inference models (worker only) ---------------------------------------
WHISPER_MODEL=distil-large-v3
WHISPER_COMPUTE_TYPE=int8
PIPER_VOICE_DIR=/data/models/piper
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
