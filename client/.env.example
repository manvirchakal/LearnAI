# Copy to .env.local (Create React App loads .env.local automatically and
# it's already gitignored) and fill in.
#
# REACT_APP_* because this is still the Create React App build; renamed to
# VITE_API_BASE_URL when the client moves to Vite in a later phase.

# Same Google OAuth client id configured as GOOGLE_CLIENT_ID on the backend
# (see the root .env.example) — the frontend only ever handles the identity
# token; verification happens server-side in services/auth/google_verifier.py.
REACT_APP_GOOGLE_CLIENT_ID=

REACT_APP_API_BASE_URL=http://localhost:8000
