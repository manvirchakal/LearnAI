# Copy to .env.local (Vite loads .env.local automatically and it's already
# gitignored) and fill in. Only VITE_-prefixed variables are exposed to the
# browser bundle, which is the whole safety mechanism — never put a secret
# behind that prefix, because it ships to every visitor.

# Same Google OAuth client id configured as GOOGLE_CLIENT_ID on the backend
# (see the root .env.example) — the frontend only ever handles the identity
# token; verification happens server-side in services/auth/google_verifier.py.
VITE_GOOGLE_CLIENT_ID=

VITE_API_BASE_URL=http://localhost:8000
